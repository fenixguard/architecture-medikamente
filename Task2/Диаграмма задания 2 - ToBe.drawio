        </mxCell>
        <mxCell id="fUjIR2gxo-P0Lv2dZSwE-19" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Пояснения к блокам схемы&lt;/h1&gt;&lt;div&gt;&lt;p&gt;&lt;strong&gt;Веб-портал&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Позволяет пользователям записываться на приём и управлять своими данными.&lt;/li&gt;&lt;br&gt;&lt;li&gt;Данные хранятся в PostgreSQL с активированной функцией TDE; файлы зашифрованы по стандарту AES-256.&lt;/li&gt;&lt;br&gt;&lt;li&gt;Передача информации происходит по защищённым каналам (TLS 1.3) через API Gateway с необходимой аутентификацией.&lt;/li&gt;&lt;br&gt;&lt;li&gt;Данные удаляются через год после окончания услуг или по первому требованию клиента.&lt;/li&gt;&lt;br&gt;&lt;li&gt;Доступ ограничен только к личной информации; для чувствительных данных применяется тегирование (PII, Medical).&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;CRM&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Предназначена для централизованного управления записью пациентов.&lt;/li&gt;&lt;br&gt;&lt;li&gt;Все сведения хранятся в одной базе данных.&lt;/li&gt;&lt;br&gt;&lt;li&gt;Взаимодействие с системой идёт через защищённый API Gateway с аутентификацией.&lt;/li&gt;&lt;br&gt;&lt;li&gt;Финансовые сведения хранятся в течение пяти лет, записи клиентов — один год.&lt;/li&gt;&lt;br&gt;&lt;li&gt;Реализован ролевой доступ (RBAC), а сама база данных зашифрована на уровне хранилища.&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;p&gt;&lt;strong&gt;Платёжный шлюз&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Осуществляет обработку транзакций клиентов.&lt;/li&gt;&lt;br&gt;&lt;li&gt;Не сохраняет детали банковских карт, используя вместо них токены.&lt;/li&gt;&lt;br&gt;&lt;li&gt;Для взаимодействия используется API, соответствующий требованиям PCI DSS.&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;p&gt;&lt;strong&gt;Интеграция с лабораторией&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Позволяет получать результаты анализов.&lt;/li&gt;&lt;br&gt;&lt;li&gt;Передача данных выполняется с шифрованием (TLS 1.3), проверкой авторизации и использованием OAuth 2.&lt;/li&gt;&lt;br&gt;&lt;li&gt;Действуют строгие API-контракты, а объём передаваемой информации сводится к минимуму.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="1220" y="-190" width="940" height="740" as="geometry" />
        </mxCell>
        <object placeholders="1" c4Name="Файловое хранилище" c4Type="Container" c4Technology="S3 подобное хранилище" c4Description="Сканы, снимки и т. д." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%:&amp;nbsp;%c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="fUjIR2gxo-P0Lv2dZSwE-20">
          <mxCell style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=12;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.5,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];resizable=0;" parent="1" vertex="1">
            <mxGeometry x="50" y="320" width="240" height="120" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="fUjIR2gxo-P0Lv2dZSwE-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="fUjIR2gxo-P0Lv2dZSwE-2" target="fUjIR2gxo-P0Lv2dZSwE-20" edge="1">
